# Server
PORT=3000

# PostgreSQL connection
DATABASE_URL=postgres://ulpf_user:ulpf_pass@localhost:5432/ulpf_db

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# AES-256-GCM master key (MUST be exactly 32 bytes, given as 64 hex chars)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AES_MASTER_KEY_HEX=

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Initial admin bootstrap (only used the very first time the server starts
# and no admin exists yet). Change the password after first login.
BOOTSTRAP_ADMIN_EMAIL=admin@ulpf.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# Initial secondary "unlock" password for viewing unmasked sensitive logs
BOOTSTRAP_SECONDARY_PASSWORD=Unlock123!
